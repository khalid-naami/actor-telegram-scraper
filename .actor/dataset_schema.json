{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "type": {
                "type": "string",
                "title": "Entity Type"
            },
            "url": {
                "type": "string",
                "title": "Telegram URL"
            },
            "previewUrl": {
                "type": "string",
                "title": "Web Preview URL"
            },
            "id": {
                "type": "string",
                "title": "Item ID / Username"
            },
            "channelName": {
                "type": "string",
                "title": "Channel Name"
            },
            "channelUsername": {
                "type": "string",
                "title": "Channel @Username"
            },
            "channelDescription": {
                "type": "string",
                "title": "Channel Bio / Description"
            },
            "subscribersCount": {
                "type": "string",
                "title": "Subscribers Count"
            },
            "subscribersCountRaw": {
                "type": "integer",
                "title": "Subscribers Raw Count"
            },
            "avatarUrl": {
                "type": "string",
                "title": "Channel Avatar URL"
            },
            "isVerified": {
                "type": "boolean",
                "title": "Verified Badge"
            },
            "messageId": {
                "type": "integer",
                "title": "Post Message ID"
            },
            "text": {
                "type": "string",
                "title": "Post Message Content"
            },
            "viewsCount": {
                "type": "string",
                "title": "Views Count (Formatted)"
            },
            "viewsCountRaw": {
                "type": "integer",
                "title": "Views Count (Numeric)"
            },
            "forwardsCount": {
                "type": "integer",
                "title": "Forwards / Shares Count"
            },
            "reactions": {
                "type": "array",
                "title": "Reactions Breakdown",
                "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "emoji": {
                            "type": "string"
                        },
                        "count": {
                            "type": "integer"
                        }
                    }
                }
            },
            "mediaType": {
                "type": "string",
                "title": "Media Type (photo, video, document, none)"
            },
            "photoUrl": {
                "type": "string",
                "title": "Direct Photo URL"
            },
            "photoUrls": {
                "type": "array",
                "title": "Gallery Photos URLs",
                "items": {
                    "type": "string"
                }
            },
            "videoUrl": {
                "type": "string",
                "title": "Video Stream URL"
            },
            "externalLinks": {
                "type": "array",
                "title": "External Links in Post",
                "items": {
                    "type": "string"
                }
            },
            "email": {
                "type": "string",
                "title": "Contact Email"
            },
            "emails": {
                "type": "array",
                "title": "Extracted Emails",
                "items": {
                    "type": "string"
                }
            },
            "phone": {
                "type": "string",
                "title": "Contact Phone"
            },
            "phones": {
                "type": "array",
                "title": "Extracted Phones",
                "items": {
                    "type": "string"
                }
            },
            "searchQuery": {
                "type": "string",
                "title": "Search Keyword"
            },
            "source": {
                "type": "string",
                "title": "Discovery Source"
            },
            "date": {
                "type": "string",
                "title": "Publication Timestamp"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped At Timestamp"
            }
        },
        "required": []
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "channelUsername",
                    "channelName",
                    "subscribersCount",
                    "messageId",
                    "text",
                    "viewsCount",
                    "mediaType",
                    "date",
                    "url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": {
                        "label": "Type",
                        "format": "text"
                    },
                    "channelUsername": {
                        "label": "Channel",
                        "format": "text"
                    },
                    "channelName": {
                        "label": "Name",
                        "format": "text"
                    },
                    "subscribersCount": {
                        "label": "Subscribers",
                        "format": "text"
                    },
                    "messageId": {
                        "label": "Msg ID",
                        "format": "number"
                    },
                    "text": {
                        "label": "Text",
                        "format": "text"
                    },
                    "viewsCount": {
                        "label": "Views",
                        "format": "text"
                    },
                    "mediaType": {
                        "label": "Media",
                        "format": "text"
                    },
                    "date": {
                        "label": "Date",
                        "format": "date"
                    },
                    "url": {
                        "label": "URL",
                        "format": "link"
                    }
                }
            }
        }
    }
}
